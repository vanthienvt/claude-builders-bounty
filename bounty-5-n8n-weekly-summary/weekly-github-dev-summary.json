{
  "name": "Weekly GitHub Dev Summary with Claude Sonnet 4",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-friday-5pm",
      "name": "Weekly Friday 5PM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "repo",
              "name": "GITHUB_REPO",
              "value": "={{ $env.GITHUB_REPO || \"Conway-Research/automaton\" }}",
              "type": "string"
            },
            {
              "id": "lang",
              "name": "SUMMARY_LANGUAGE",
              "value": "={{ $env.SUMMARY_LANGUAGE || \"EN\" }}",
              "type": "string"
            },
            {
              "id": "webhook",
              "name": "WEBHOOK_URL",
              "value": "={{ $env.DISCORD_SLACK_WEBHOOK_URL }}",
              "type": "string"
            },
            {
              "id": "since",
              "name": "SINCE_ISO",
              "value": "={{ new Date(Date.now() - 7 * 86400000).toISOString() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "config-vars",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_REPO }}/commits?since={{ $json.SINCE_ISO }}&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $node[\"Config Variables\"].json.GITHUB_REPO }}/issues?state=closed&since={{ $node[\"Config Variables\"].json.SINCE_ISO }}&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "fetch-issues-prs",
      "name": "Fetch Closed Issues & Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate an executive weekly engineering narrative summary in language (\" + $node[\"Config Variables\"].json.SUMMARY_LANGUAGE + \") for repo \" + $node[\"Config Variables\"].json.GITHUB_REPO + \" covering highlights, merged PRs, closed issues, and key commits.\"\n    }\n  ]\n}"
      },
      "id": "claude-sonnet-summary",
      "name": "Claude Sonnet 4 Narrative Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Config Variables\"].json.WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": $json.content[0].text,\n  \"text\": $json.content[0].text\n}"
      },
      "id": "post-webhook",
      "name": "Deliver Summary to Discord / Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Friday 5PM Trigger": {
      "main": [
        [
          {
            "node": "Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Variables": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues & Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Claude Sonnet 4 Narrative Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues & Merged PRs": {
      "main": [
        [
          {
            "node": "Claude Sonnet 4 Narrative Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Sonnet 4 Narrative Generator": {
      "main": [
        [
          {
            "node": "Deliver Summary to Discord / Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}